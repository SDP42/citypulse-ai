# Safe defaults: everything offline, no models, synthetic data.
DATA_MODE=synthetic        # synthetic | real  (never mixed in one aggregate)
NETWORK=off                # off | allowlist
NETWORK_ALLOWLIST=         # comma-separated hosts, only when NETWORK=allowlist
LLM_PROVIDER=none          # none | ollama  (remote providers intentionally unsupported)
OLLAMA_URL=http://127.0.0.1:11434
DB_PATH=data/db/citypulse.sqlite
PILOT_AREA=                # chosen only after source/boundary verification
MAX_UPLOAD_MB=25
